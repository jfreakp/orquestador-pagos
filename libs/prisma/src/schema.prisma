generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Catálogos
// ---------------------------------------------------------------------------

model Gateway {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  gatewayConfigs GatewayConfig[]
  transactions   Transaction[]
  webhookEvents  GatewayWebhookEvent[]

  @@map("gateways")
}

model Channel {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  gatewayConfigs GatewayConfig[]
  transactions   Transaction[]

  @@map("channels")
}

model TransactionStatus {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transactions  Transaction[]
  statusHistory TransactionStatusHistory[]

  @@map("transaction_statuses")
}

model GatewayOperationType {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  statusHistory TransactionStatusHistory[]
  errors        TransactionError[]

  @@map("gateway_operation_types")
}

model ErrorCategory {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  errors TransactionError[]

  @@map("error_categories")
}

// ---------------------------------------------------------------------------
// Sistemas clientes y configuración de gateways
// ---------------------------------------------------------------------------

model ClientSystem {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  // Llave pública RS256; el claim `iss` del JWT identifica al sistema.
  // La llave privada nunca se guarda aquí.
  publicKey String   @map("public_key")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transactions Transaction[]

  @@map("client_systems")
}

model GatewayConfig {
  id        Int      @id @default(autoincrement())
  gatewayId Int      @map("gateway_id")
  channelId Int      @map("channel_id")
  // AES-256-GCM cifrado a nivel de aplicación (nunca texto plano).
  credentials Bytes
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  gateway    Gateway            @relation(fields: [gatewayId], references: [id])
  channel    Channel            @relation(fields: [channelId], references: [id])
  authTokens GatewayAuthToken[]

  @@unique([gatewayId, channelId])
  @@map("gateway_configs")
}

model GatewayAuthToken {
  id              Int      @id @default(autoincrement())
  gatewayConfigId Int      @map("gateway_config_id")
  // Cifrado igual que credentials; se reutiliza mientras no expire.
  accessToken     Bytes    @map("access_token")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  gatewayConfig GatewayConfig @relation(fields: [gatewayConfigId], references: [id])

  @@map("gateway_auth_tokens")
}

// ---------------------------------------------------------------------------
// Transacciones
// ---------------------------------------------------------------------------

model Transaction {
  id     String @id @default(uuid())
  // Identificador expuesto a sistemas clientes (GET /transactions/:publicId).
  publicId String @unique @default(uuid()) @map("public_id")

  clientSystemId      Int    @map("client_system_id")
  gatewayId           Int    @map("gateway_id")
  channelId           Int    @map("channel_id")
  transactionStatusId Int    @map("transaction_status_id")

  // Único junto con clientSystemId: reintentos con la misma key devuelven
  // la transacción existente sin reprocesar.
  idempotencyKey String @map("idempotency_key")

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("USD")

  // Deeplink de cobro; el QR se regenera al vuelo y no se persiste.
  paymentLink String? @map("payment_link")

  // Se guardan ambas versiones del payload: el sobre cifrado tal cual viajó
  // y el JSON de negocio ya desencriptado.
  requestEncrypted  Bytes? @map("request_encrypted")
  requestPlain      Json?  @map("request_plain")
  responseEncrypted Bytes? @map("response_encrypted")
  responsePlain     Json?  @map("response_plain")

  externalReference String? @map("external_reference")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clientSystem      ClientSystem        @relation(fields: [clientSystemId], references: [id])
  gateway           Gateway             @relation(fields: [gatewayId], references: [id])
  channel           Channel             @relation(fields: [channelId], references: [id])
  transactionStatus TransactionStatus   @relation(fields: [transactionStatusId], references: [id])
  statusHistory     TransactionStatusHistory[]
  errors            TransactionError[]
  webhookEvents     GatewayWebhookEvent[]

  @@unique([clientSystemId, idempotencyKey])
  @@map("transactions")
}

model TransactionStatusHistory {
  id                     Int      @id @default(autoincrement())
  transactionId          String   @map("transaction_id")
  transactionStatusId    Int      @map("transaction_status_id")
  gatewayOperationTypeId Int?     @map("gateway_operation_type_id")
  note                   String?
  createdAt              DateTime @default(now()) @map("created_at")

  transaction          Transaction           @relation(fields: [transactionId], references: [id])
  transactionStatus    TransactionStatus     @relation(fields: [transactionStatusId], references: [id])
  gatewayOperationType GatewayOperationType? @relation(fields: [gatewayOperationTypeId], references: [id])

  @@map("transaction_status_history")
}

model TransactionError {
  id                     Int      @id @default(autoincrement())
  transactionId          String   @map("transaction_id")
  errorCategoryId        Int      @map("error_category_id")
  gatewayOperationTypeId Int?     @map("gateway_operation_type_id")
  message                String
  details                Json?
  createdAt              DateTime @default(now()) @map("created_at")

  transaction          Transaction           @relation(fields: [transactionId], references: [id])
  errorCategory        ErrorCategory         @relation(fields: [errorCategoryId], references: [id])
  gatewayOperationType GatewayOperationType? @relation(fields: [gatewayOperationTypeId], references: [id])

  @@map("transaction_errors")
}

model GatewayWebhookEvent {
  id            Int    @id @default(autoincrement())
  gatewayId     Int    @map("gateway_id")
  transactionId String? @map("transaction_id")

  payloadEncrypted Bytes? @map("payload_encrypted")
  payloadPlain     Json?  @map("payload_plain")
  signatureValid   Boolean @map("signature_valid")
  processedAt      DateTime? @map("processed_at")
  createdAt        DateTime @default(now()) @map("created_at")

  gateway     Gateway      @relation(fields: [gatewayId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@map("gateway_webhook_events")
}
