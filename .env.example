# PostgreSQL connection string used by Prisma for local development
# (outside Docker). Inside docker-compose, the backend's DATABASE_URL is
# built from POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB below instead.
DATABASE_URL="postgresql://user:password@localhost:5432/orquestador_pagos?schema=public"

# Used by the postgres service in docker-compose.yml, and to build the
# backend's DATABASE_URL inside the Docker network.
POSTGRES_USER=orquestador
POSTGRES_PASSWORD=orquestador
POSTGRES_DB=orquestador_pagos

# AES-256-GCM master key used to encrypt/decrypt gateway credentials at rest.
# Must decode (base64) to exactly 32 bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_MASTER_KEY=

# HTTP port for apps/backend
PORT=3000

# HS256 secret used to sign/verify admin session JWTs issued by
# POST /admin-auth/login. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_JWT_SECRET=

# Used only by `npx prisma db seed` to create the initial Admin row.
# Leave ADMIN_SEED_PASSWORD empty to skip creating/updating the seed admin.
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=
