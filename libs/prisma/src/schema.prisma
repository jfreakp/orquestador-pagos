generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Catálogos
// ---------------------------------------------------------------------------

/// Pasarela de pago integrada por el orquestador (Ahorita, Deuna, PlaceToPay).
/// Cada gateway tiene su propia implementación de PaymentGatewayClient,
/// seleccionada en tiempo de ejecución vía factory según este código.
model Gateway {
  id        Int      @id @default(autoincrement())
  /// Código corto usado para resolver la implementación (p.ej. "ahorita").
  code      String   @unique
  /// Nombre legible para mostrar en el panel de administración.
  name      String
  /// Si es false, el gateway no puede recibir nuevos pagos.
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  gatewayConfigs GatewayConfig[]
  transactions   Transaction[]
  webhookEvents  GatewayWebhookEvent[]
  authTokens     GatewayAuthToken[]

  @@map("gateways")
}

/// Canal de origen de un pago (WEB, OFICINA, APP). Cada gateway puede tener
/// credenciales/configuración distinta por canal.
model Channel {
  id        Int      @id @default(autoincrement())
  /// Código corto del canal (p.ej. "WEB").
  code      String   @unique
  /// Nombre legible para mostrar en el panel de administración.
  name      String
  /// Si es false, el canal no puede iniciar nuevos pagos.
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  gatewayConfigs GatewayConfig[]
  transactions   Transaction[]

  @@map("channels")
}

/// Estado del ciclo de vida de una transacción (PENDING, APPROVED, REJECTED,
/// ERROR, REVERSED, EXPIRED).
model TransactionStatus {
  id        Int      @id @default(autoincrement())
  /// Código corto del estado (p.ej. "APPROVED").
  code      String   @unique
  /// Nombre legible para mostrar en el panel de administración.
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transactions  Transaction[]
  statusHistory TransactionStatusHistory[]

  @@map("transaction_statuses")
}

/// Tipo de operación realizada contra un gateway (CREATE_PAYMENT,
/// QUERY_STATUS, REFUND, AUTHORIZE_ACCESS, REFRESH_TOKEN, REVOKE_TOKEN,
/// GENERATE_PAYMENT_LINK, PAYMENT_WEBHOOK_NOTIFICATION). Etiqueta cada
/// entrada del historial de estados y cada error para saber qué operación
/// los originó.
model GatewayOperationType {
  id        Int      @id @default(autoincrement())
  /// Código corto de la operación (p.ej. "CREATE_PAYMENT").
  code      String   @unique
  /// Nombre legible para mostrar en el panel de administración.
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  statusHistory TransactionStatusHistory[]
  errors        TransactionError[]

  @@map("gateway_operation_types")
}

/// Categoría de un error de transacción (COMMUNICATION, BUSINESS, INTERNAL,
/// AUTH), usada para clasificar y filtrar fallos en el monitor.
model ErrorCategory {
  id        Int      @id @default(autoincrement())
  /// Código corto de la categoría (p.ej. "COMMUNICATION").
  code      String   @unique
  /// Nombre legible para mostrar en el panel de administración.
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  errors TransactionError[]

  @@map("error_categories")
}

// ---------------------------------------------------------------------------
// Sistemas clientes y configuración de gateways
// ---------------------------------------------------------------------------

/// Sistema externo autorizado a crear pagos a través del orquestador.
/// Se autentica con un JWT RS256 firmado con su llave privada; el
/// orquestador solo conoce la llave pública.
model ClientSystem {
  id        Int      @id @default(autoincrement())
  /// Código corto del sistema, usado como claim `iss` en su JWT.
  code      String   @unique
  /// Nombre legible para mostrar en el panel de administración.
  name      String
  /// Llave pública RS256 (PEM) usada para verificar la firma del JWT.
  /// La llave privada nunca se guarda aquí.
  publicKey String   @map("public_key")
  /// Si es false, sus JWT son rechazados aunque la firma sea válida.
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transactions Transaction[]

  @@map("client_systems")
}

/// Credenciales y configuración de un gateway para un canal específico
/// (p.ej. credenciales de Ahorita para el canal WEB).
model GatewayConfig {
  id        Int      @id @default(autoincrement())
  gatewayId Int      @map("gateway_id")
  channelId Int      @map("channel_id")
  /// Credenciales del gateway (clientCode, llaves PEM, merchantHash, etc.)
  /// serializadas a JSON y cifradas con AES-256-GCM a nivel de aplicación;
  /// nunca se guardan ni se exponen en texto plano.
  credentials Bytes
  /// Si es false, el gateway no puede usarse en este canal.
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  gateway Gateway @relation(fields: [gatewayId], references: [id])
  channel Channel @relation(fields: [channelId], references: [id])

  @@unique([gatewayId, channelId])
  @@map("gateway_configs")
}

/// Token de acceso vigente frente a un gateway. Se reutiliza mientras no
/// expire; su renovación está protegida por un advisory lock de PostgreSQL
/// tomado por gateway (`'gateway_token_' || code`) para evitar que dos
/// requests concurrentes lo autentiquen dos veces.
model GatewayAuthToken {
  id        Int @id @default(autoincrement())
  gatewayId Int @map("gateway_id")
  /// Token de acceso cifrado con AES-256-GCM; nunca se loguea en texto plano.
  accessToken  Bytes  @map("access_token")
  /// Token de refresco cifrado; null si el gateway no soporta refresh.
  refreshToken Bytes? @map("refresh_token")
  /// Momento en que el accessToken deja de ser válido.
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  gateway Gateway @relation(fields: [gatewayId], references: [id])

  @@map("gateway_auth_tokens")
}

// ---------------------------------------------------------------------------
// Transacciones
// ---------------------------------------------------------------------------

/// Un pago solicitado por un sistema cliente a través del orquestador.
/// Registra el estado actual, los payloads intercambiados con el gateway
/// (cifrados y en claro) y el link de cobro cuando aplica.
model Transaction {
  id     String @id @default(uuid())
  /// Identificador expuesto a sistemas clientes (GET /transactions/:publicId);
  /// distinto del id interno para no filtrar el UUID de fila real.
  publicId String @unique @default(uuid()) @map("public_id")

  clientSystemId      Int    @map("client_system_id")
  gatewayId           Int    @map("gateway_id")
  channelId           Int    @map("channel_id")
  transactionStatusId Int    @map("transaction_status_id")

  /// Clave de idempotencia enviada por el sistema cliente. Junto con
  /// clientSystemId forma una unique constraint: reintentos con la misma
  /// key devuelven la transacción existente sin reprocesar el pago.
  idempotencyKey String @map("idempotency_key")

  /// Monto del pago con precisión de 2 decimales.
  amount   Decimal @db.Decimal(12, 2)
  /// Moneda ISO del pago.
  currency String  @default("USD")

  /// Deeplink/URL de cobro devuelto por el gateway (p.ej. Ahorita). El QR
  /// correspondiente se regenera al vuelo a partir de este campo y no se
  /// persiste en la base de datos.
  paymentLink String? @map("payment_link")

  /// Sobre cifrado del request tal cual viajó hacia el gateway.
  requestEncrypted  Bytes? @map("request_encrypted")
  /// JSON de negocio del request ya desencriptado, para inspección/soporte.
  requestPlain      Json?  @map("request_plain")
  /// Sobre cifrado de la respuesta tal cual llegó desde el gateway.
  responseEncrypted Bytes? @map("response_encrypted")
  /// JSON de negocio de la respuesta ya desencriptado, para inspección/soporte.
  responsePlain     Json?  @map("response_plain")

  /// Identificador de la transacción en el sistema del gateway externo.
  externalReference String? @map("external_reference")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clientSystem      ClientSystem        @relation(fields: [clientSystemId], references: [id])
  gateway           Gateway             @relation(fields: [gatewayId], references: [id])
  channel           Channel             @relation(fields: [channelId], references: [id])
  transactionStatus TransactionStatus   @relation(fields: [transactionStatusId], references: [id])
  statusHistory     TransactionStatusHistory[]
  errors            TransactionError[]
  webhookEvents     GatewayWebhookEvent[]

  @@unique([clientSystemId, idempotencyKey])
  @@map("transactions")
}

/// Registro histórico de cada cambio de estado de una transacción, con la
/// operación de gateway que lo originó. Permite reconstruir la línea de
/// tiempo completa de un pago en el monitor de transacciones.
model TransactionStatusHistory {
  id                     Int      @id @default(autoincrement())
  transactionId          String   @map("transaction_id")
  /// Estado al que transicionó la transacción en este punto.
  transactionStatusId    Int      @map("transaction_status_id")
  /// Operación de gateway que causó la transición; null si fue interna.
  gatewayOperationTypeId Int?     @map("gateway_operation_type_id")
  /// Detalle libre opcional (p.ej. motivo de rechazo del gateway).
  note                   String?
  createdAt              DateTime @default(now()) @map("created_at")

  transaction          Transaction           @relation(fields: [transactionId], references: [id])
  transactionStatus    TransactionStatus     @relation(fields: [transactionStatusId], references: [id])
  gatewayOperationType GatewayOperationType? @relation(fields: [gatewayOperationTypeId], references: [id])

  @@map("transaction_status_history")
}

/// Error ocurrido durante el procesamiento de un pago o durante la
/// autenticación de un sistema cliente, clasificado por categoría para
/// facilitar el diagnóstico en el monitor de transacciones.
model TransactionError {
  id                     Int      @id @default(autoincrement())
  /// Nullable: errores de autenticación (guard JWT) ocurren antes de que
  /// exista una transacción (p.ej. issuer desconocido o firma inválida).
  transactionId          String?  @map("transaction_id")
  /// Clasificación del error (COMMUNICATION, BUSINESS, INTERNAL, AUTH).
  errorCategoryId        Int      @map("error_category_id")
  /// Operación de gateway durante la cual ocurrió el error, si aplica.
  gatewayOperationTypeId Int?     @map("gateway_operation_type_id")
  /// Mensaje de error legible para soporte/administración.
  message                String
  /// Detalle estructurado adicional (stack trace, respuesta cruda, etc.).
  details                Json?
  createdAt              DateTime @default(now()) @map("created_at")

  transaction          Transaction?          @relation(fields: [transactionId], references: [id])
  errorCategory        ErrorCategory         @relation(fields: [errorCategoryId], references: [id])
  gatewayOperationType GatewayOperationType? @relation(fields: [gatewayOperationTypeId], references: [id])

  @@map("transaction_errors")
}

/// Notificación asíncrona (webhook) recibida de un gateway, típicamente
/// para confirmar el resultado de un pago iniciado por link de cobro.
model GatewayWebhookEvent {
  id            Int    @id @default(autoincrement())
  gatewayId     Int    @map("gateway_id")
  /// Transacción a la que corresponde la notificación; null si no se pudo
  /// correlacionar con ninguna transacción conocida.
  transactionId String? @map("transaction_id")

  /// Sobre cifrado del payload del webhook tal cual llegó del gateway.
  payloadEncrypted Bytes? @map("payload_encrypted")
  /// JSON de negocio del payload ya desencriptado, para inspección/soporte.
  payloadPlain     Json?  @map("payload_plain")
  /// Resultado de verificar la firma HMAC del webhook contra el secreto
  /// configurado para el gateway.
  signatureValid   Boolean @map("signature_valid")
  /// Momento en que se procesó el evento; null mientras sigue pendiente.
  processedAt      DateTime? @map("processed_at")
  createdAt        DateTime @default(now()) @map("created_at")

  gateway     Gateway      @relation(fields: [gatewayId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@map("gateway_webhook_events")
}
